!pragma layout smetana
skinparam backgroundColor #141414
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #f5f5f5
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #8fbfff
skinparam ArrowFontColor #f5f5f5
skinparam componentBackgroundColor #191919
skinparam componentBorderColor #8fbfff
skinparam packageBackgroundColor #141414
skinparam packageBorderColor #80d1c1
skinparam nodeBackgroundColor #191919
skinparam nodeBorderColor #80d1c1
skinparam cloudBackgroundColor #191919
skinparam cloudBorderColor #f69f16
skinparam databaseBackgroundColor #191919
skinparam databaseBorderColor #80d1c1
skinparam artifactBackgroundColor #191919
skinparam artifactBorderColor #80d1c1
skinparam noteBackgroundColor #191919
skinparam noteBorderColor #f69f16
skinparam participantBackgroundColor #191919
skinparam participantBorderColor #80d1c1
skinparam actorBackgroundColor #191919
skinparam actorBorderColor #80d1c1
skinparam sequenceLifeLineBorderColor #80d1c1
skinparam sequenceGroupBackgroundColor #191919
skinparam sequenceGroupBorderColor #f69f16
skinparam sequenceBoxBackgroundColor #191919
