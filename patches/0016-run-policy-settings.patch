+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+// Names of OmnIDE's run-policy settings. No imports, so tests and both the settings registry and the agent host can share them.
+
+export const RunPolicyConfigKey = {
+	RunMode: 'runMode',
+	DefaultChatMode: 'defaultChatMode',
+	Allowlist: 'allowlist',
+	ProtectFileDeletion: 'protectFileDeletion',
+	ProtectExternalFiles: 'protectExternalFiles',
+	RunEverythingAccepted: 'runEverythingAccepted',
+} as const;
+
+export const RunPolicySettingId = {
+	RunMode: 'omnide.agents.runMode',
+	DefaultChatMode: 'omnide.agents.defaultChatMode',
+	Allowlist: 'omnide.agents.allowlist',
+	ProtectFileDeletion: 'omnide.agents.protections.fileDeletion',
+	ProtectExternalFiles: 'omnide.agents.protections.externalFiles',
+	RunEverythingAccepted: 'omnide.agents.runEverythingAccepted',
+} as const;
+
+export const RUN_MODE_VALUES = ['autoReview', 'allowlist', 'runEverything'] as const;
+export const DEFAULT_CHAT_MODE_VALUES = ['agent', 'plan', 'ask'] as const;
