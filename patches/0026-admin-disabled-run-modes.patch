diff --git a/src/vs/platform/agentHost/common/claudeRunPolicy.ts b/src/vs/platform/agentHost/common/claudeRunPolicy.ts
index 6b133f57..06d1c7e8 100644
--- a/src/vs/platform/agentHost/common/claudeRunPolicy.ts
+++ b/src/vs/platform/agentHost/common/claudeRunPolicy.ts
@@ -40,6 +40,36 @@ export function agentSdkMode(s: IRunPolicyState): SdkPermissionMode {
 	}
 }
 
+/** Run Everything may start a session with `allowDangerouslySkipPermissions` only after its warning, and never when an admin disabled bypass. */
+export function allowSkipPermissions(s: IRunPolicyState): boolean {
+	return s.runMode === 'runEverything' && s.runEverythingAccepted && !s.bypassDisabled;
+}
+
+export interface IAdminFlags {
+	readonly autoDisabled: boolean;
+	readonly bypassDisabled: boolean;
+}
+
+/** Locks across managed sources: either one setting `disableAutoMode` or `permissions.disableBypassPermissionsMode` to "disable" turns the mode off. */
+export function adminFlagsOf(documents: readonly unknown[]): IAdminFlags {
+	const objects = documents.filter((d): d is Record<string, unknown> => typeof d === 'object' && d !== null && !Array.isArray(d));
+	const permissions = (d: Record<string, unknown>) => typeof d.permissions === 'object' && d.permissions !== null ? d.permissions as Record<string, unknown> : {};
+	return {
+		autoDisabled: objects.some(d => d.disableAutoMode === 'disable'),
+		bypassDisabled: objects.some(d => permissions(d).disableBypassPermissionsMode === 'disable'),
+	};
+}
+
+/** Directory of the file-based managed settings (code.claude.com/docs/en/managed-settings). `override` is for tests. */
+export function managedSettingsDir(platform: 'darwin' | 'win32' | 'linux', override?: string): string {
+	return override ?? (platform === 'darwin' ? '/Library/Application Support/ClaudeCode' : platform === 'win32' ? 'C:\\Program Files\\ClaudeCode' : '/etc/claude-code');
+}
+
+/** A mode an admin disabled becomes `acceptEdits` (Allowlist), so a chat never starts or switches into it. */
+export function clampMode<M extends string>(mode: M, f: IAdminFlags): M | 'acceptEdits' {
+	return (mode === 'auto' && f.autoDisabled) || (mode === 'bypassPermissions' && f.bypassDisabled) ? 'acceptEdits' : mode;
+}
+
 export function sdkModeFor(chat: ChatMode, s: IRunPolicyState): SdkPermissionMode {
 	return chat === 'plan' ? 'plan' : chat === 'ask' ? 'default' : agentSdkMode(s);
 }
