diff --git a/src/vs/platform/agentHost/node/claude/claudeManagedSettings.ts b/src/vs/platform/agentHost/node/claude/claudeManagedSettings.ts
new file mode 100644
index 00000000..34dfa67c
--- /dev/null
+++ b/src/vs/platform/agentHost/node/claude/claudeManagedSettings.ts
@@ -0,0 +1,68 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { execFileSync } from 'child_process';
+import { readdirSync, readFileSync } from 'fs';
+import { join } from '../../../../base/common/path.js';
+import { adminFlagsOf, type IAdminFlags, managedSettingsDir } from '../../common/claudeRunPolicy.js';
+
+// Admin-managed Claude Code settings on this machine: the system-directory files, the macOS profile and the Windows HKLM value
+// (code.claude.com/docs/en/managed-settings). Server-managed settings are not readable from here; Claude Code still enforces them.
+
+const platform = process.platform === 'darwin' || process.platform === 'win32' ? process.platform : 'linux';
+
+function parse(text: string): unknown[] {
+	try {
+		return [JSON.parse(text)];
+	} catch {
+		return [];
+	}
+}
+
+function readFile(path: string): unknown[] {
+	try {
+		return parse(readFileSync(path, 'utf8'));
+	} catch {
+		return [];
+	}
+}
+
+function run(file: string, args: string[]): string {
+	try {
+		return execFileSync(file, args, { encoding: 'utf8', timeout: 3000, stdio: ['ignore', 'pipe', 'ignore'] });
+	} catch {
+		return '';
+	}
+}
+
+function readDocuments(): unknown[] {
+	const override = process.env.OMNIDE_MANAGED_SETTINGS_DIR;
+	const dir = managedSettingsDir(platform, override);
+	let drops: string[] = [];
+	try {
+		drops = readdirSync(join(dir, 'managed-settings.d')).filter(f => f.endsWith('.json')).sort();
+	} catch { /* no drop-in directory */ }
+	const docs = [...readFile(join(dir, 'managed-settings.json')), ...drops.flatMap(f => readFile(join(dir, 'managed-settings.d', f)))];
+	if (override) {
+		return docs;
+	}
+	if (platform === 'darwin') {
+		docs.push(...parse(run('plutil', ['-convert', 'json', '-o', '-', '/Library/Managed Preferences/com.anthropic.claudecode.plist'])));
+	} else if (platform === 'win32') {
+		const value = /^\s*Settings\s+REG_(?:EXPAND_)?SZ\s+(.*)$/m.exec(run('reg', ['query', 'HKLM\\SOFTWARE\\Policies\\ClaudeCode', '/v', 'Settings']));
+		docs.push(...(value ? parse(value[1].trim()) : []));
+	}
+	return docs;
+}
+
+let cached: { readonly at: number; readonly flags: IAdminFlags } | undefined;
+
+/** Read at most every 5 seconds: callers run on every chat start and mode change, and the plist and registry reads spawn a process. */
+export function readAdminFlags(): IAdminFlags {
+	const now = Date.now();
+	if (!cached || now - cached.at > 5000) {
+		cached = { at: now, flags: adminFlagsOf(readDocuments()) };
+	}
+	return cached.flags;
+}
