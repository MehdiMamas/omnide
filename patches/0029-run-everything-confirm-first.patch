+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import Severity from '../../../base/common/severity.js';
+import { localize } from '../../../nls.js';
+import { IConfigurationService } from '../../configuration/common/configuration.js';
+import { IDialogService } from '../../dialogs/common/dialogs.js';
+import { RunPolicySettingId } from './claudeRunPolicyConfig.js';
+
+/** Asks once before Run Mode becomes Run Everything. Returns whether it may be set; the answer is kept in `omnide.agents.runEverythingAccepted`. */
+export async function confirmRunEverything(dialogs: IDialogService, config: IConfigurationService): Promise<boolean> {
+	if (config.getValue(RunPolicySettingId.RunEverythingAccepted) === true) {
+		return true;
+	}
+	const { confirmed } = await dialogs.confirm({
+		type: Severity.Warning,
+		message: localize('omnide.runEverything.title', "Run Everything skips every approval"),
+		detail: localize('omnide.runEverything.detail', "Claude will run commands and edit files without asking. Deny and ask rules still apply, and File-Deletion Protection still asks before rm; Allowlist rules have no effect. Use it only in a sandbox or a project you trust.\n\nOmnIDE asks once. Your answer is kept in OmnIDE settings, not in Claude's."),
+		primaryButton: localize('omnide.runEverything.accept', "I accept the risk"),
+		cancelButton: localize('omnide.runEverything.cancel', "Cancel"),
+	});
+	if (confirmed) {
+		await config.updateValue(RunPolicySettingId.RunEverythingAccepted, true);
+	}
+	return confirmed;
+}
