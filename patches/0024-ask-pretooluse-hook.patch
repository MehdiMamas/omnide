 /** Tools Ask refuses at call time. Never deny rules: Claude Code drops a denied tool at start and never brings it back. */
-export const ASK_REFUSED_TOOLS: readonly string[] = ['Edit', 'Write', 'NotebookEdit'];
+export const ASK_REFUSED_TOOLS: readonly string[] = ['Edit', 'Write', 'MultiEdit', 'NotebookEdit'];
 export const ASK_REFUSAL_MESSAGE = 'Edit refused. Ask mode has no edit access. Switch to Agent to edit.';
 
 export function askRefusal(mode: SdkPermissionMode, toolName: string): string | undefined {
 	return mode === 'default' && ASK_REFUSED_TOOLS.includes(toolName) ? ASK_REFUSAL_MESSAGE : undefined;
 }
+
+/** What the `PreToolUse` hook answers in Ask. Hooks run before allow rules, so a rule cannot skip the refusal or the card. */
+export function askHookDecision(mode: SdkPermissionMode, toolName: string): { readonly permissionDecision: 'deny' | 'ask'; readonly permissionDecisionReason?: string } | undefined {
+	const refusal = askRefusal(mode, toolName);
+	if (refusal) {
+		return { permissionDecision: 'deny', permissionDecisionReason: refusal };
+	}
+	return mode === 'default' && (toolName === 'Bash' || toolName.startsWith('mcp__')) ? { permissionDecision: 'ask' } : undefined;
+}
+
+/** A deny from the Agent Merge restriction always wins; Ask's `ask` is only asked when the restriction has nothing to say. */
+export function mergeRestrictionFirst<T>(restriction: () => T | undefined, askHook: () => T | undefined): T | undefined {
+	return restriction() ?? askHook();
+}
