+	/** Shift+Tab: moves a Claude chat to its next mode (Agent, Plan, Ask). Returns false when there is no such picker. */
+	public cycleClaudeChatMode(): boolean {
+		const picker = this.agentHostPickers.get(ClaudeSessionConfigKey.PermissionMode);
+		if (!picker?.triggerElement?.isConnected) {
