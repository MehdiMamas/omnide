+	/** Moves the chat to its next mode: Agent, Plan, Ask. Each chat keeps its own. */
+	async cycleChatMode(): Promise<void> {
+		const context = this._readContext(ClaudeSessionConfigKey.PermissionMode);
+		const current = narrowClaudePermissionMode(context?.value);
+		if (!context || !current || !Array.isArray(context.schema.enum)) {
+			return;
+		}
+		const next = nextChatMode(chatModeOf(current));
+		const target = context.schema.enum.find(value => {
+			const mode = narrowClaudePermissionMode(value);
+			return mode !== undefined && chatModeOf(mode) === next;
+		});
+		if (typeof target === 'string') {
+			await this._setValue(context, target, ClaudeSessionConfigKey.PermissionMode);
+		}
+	}
