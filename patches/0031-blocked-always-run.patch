@@ -0,0 +1,34 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { VSBuffer } from '../../../../../../base/common/buffer.js';
+import { localize } from '../../../../../../nls.js';
+import { alwaysRunRule, withAllowRule } from '../../../../../../platform/agentHost/common/claudeRunPolicy.js';
+import { CommandsRegistry } from '../../../../../../platform/commands/common/commands.js';
+import { IFileService } from '../../../../../../platform/files/common/files.js';
+import { ServicesAccessor } from '../../../../../../platform/instantiation/common/instantiation.js';
+import { INotificationService } from '../../../../../../platform/notification/common/notification.js';
+import { IWorkspaceContextService } from '../../../../../../platform/workspace/common/workspace.js';
+
+export const ALWAYS_RUN_BLOCKED_COMMAND = 'omnide.agents.alwaysRunBlocked';
+
+/** Writes the narrow allow rule for a refused call into <folder>/.claude/settings.local.json, the file Claude Code's own Always Run writes. */
+CommandsRegistry.registerCommand(ALWAYS_RUN_BLOCKED_COMMAND, async (accessor: ServicesAccessor, tool: string, input: Readonly<Record<string, string>>) => {
+	const notifications = accessor.get(INotificationService);
+	const folder = accessor.get(IWorkspaceContextService).getWorkspace().folders[0]?.uri;
+	const rule = folder && alwaysRunRule(tool, input, folder.path);
+	if (!folder || !rule) {
+		notifications.warn(localize('omnide.alwaysRun.none', "Always Run can't write a rule for this call."));
+		return;
+	}
+	const files = accessor.get(IFileService);
+	const file = folder.with({ path: `${folder.path}/.claude/settings.local.json` });
+	const existing = await files.readFile(file).then(f => f.value.toString(), () => undefined);
+	try {
+		await files.writeFile(file, VSBuffer.fromString(withAllowRule(existing, rule)));
+		notifications.info(localize('omnide.alwaysRun.done', "Always Run saved {0}", rule));
+	} catch (e) {
+		notifications.warn(localize('omnide.alwaysRun.failed', "Always Run could not save the rule: {0}", e instanceof Error ? e.message : String(e)));
+	}
+});
