diff --git a/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostAlwaysRunBlocked.ts b/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostAlwaysRunBlocked.ts
