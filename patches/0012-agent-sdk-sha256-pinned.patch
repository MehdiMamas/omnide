+ *--------------------------------------------------------------------------------------------*/
+
+import { createHash } from 'crypto';
+import { createReadStream } from 'fs';
+
+/** Hex sha256 of a file, streamed so a 130 MB tarball is never held in memory. */
+export async function sha256OfFile(file: string): Promise<string> {
+	const hash = createHash('sha256');
+	for await (const chunk of createReadStream(file)) {
+		hash.update(chunk as Buffer);
+	}
+	return hash.digest('hex');
+}
+
+/**
+ * Checks a downloaded SDK's sha256 against `product.agentSdks.<id>.sha256`, which maps sdkTarget to a hex digest.
+ * Returns an error message, or `undefined` when the download may be used. A missing map, or a map without a
+ * (non-empty) entry for the target, is refused so a missing pin cannot skip the check.
+ */
+export function checkSdkSha256(pinned: { readonly [sdkTarget: string]: string } | undefined, sdkTarget: string, actual: string): string | undefined {
+	if (!pinned) {
+		return `no sha256 map is pinned for the SDK, refusing ${sdkTarget}`;
+	}
+	const expected = Object.hasOwn(pinned, sdkTarget) ? pinned[sdkTarget].toLowerCase() : undefined;
+	if (!expected) {
+		return `no sha256 is pinned for ${sdkTarget}`;
+	}
+	return expected === actual.toLowerCase() ? undefined : `sha256 mismatch for ${sdkTarget}: expected ${expected}, got ${actual}`;
+}
