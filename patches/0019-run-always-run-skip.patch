+
+// Names of OmnIDE's run-policy settings and the confirmation-card options, shared by the settings registry and the agent host.
 
 export const RunPolicyConfigKey = {
 	RunMode: 'runMode',
@@ -27,3 +30,35 @@ export const DEFAULT_CHAT_MODE_VALUES = ['agent', 'plan', 'ask'] as const;
 
 /** Equals `@anthropic-ai/claude-agent-sdk` in vscode/package.json; the bundled Claude Code version follows from it. */
 export const PINNED_CLAUDE_AGENT_SDK_VERSION = '0.3.304';
+
+const ALWAYS_RUN_OPTION_PREFIX = 'omnide-always-run:';
+
+/** Option id for Always Run: carries the rule and the settings file it is written to. */
+export function alwaysRunOptionId(file: string, rule: string): string {
+	return ALWAYS_RUN_OPTION_PREFIX + JSON.stringify({ file, rule });
+}
+
+/** Decodes {@link alwaysRunOptionId}; `undefined` for any other id. */
+export function parseAlwaysRunOptionId(id: string): { readonly file: string; readonly rule: string } | undefined {
+	if (!id.startsWith(ALWAYS_RUN_OPTION_PREFIX)) {
+		return undefined;
+	}
+	try {
+		const v: unknown = JSON.parse(id.slice(ALWAYS_RUN_OPTION_PREFIX.length));
+		if (typeof v === 'object' && v !== null && 'file' in v && 'rule' in v && typeof v.file === 'string' && typeof v.rule === 'string') {
+			return { file: v.file, rule: v.rule };
+		}
+	} catch {
+		// not ours
+	}
+	return undefined;
+}
+
+/** The three buttons on the confirmation card: Run, Skip, and Always Run when a narrow rule exists. */
+export function runSkipAlwaysOptions(always: { readonly file: string; readonly rule: string } | undefined): ConfirmationOption[] {
+	return [
+		{ id: 'allow-once', label: localize('omnide.runPolicy.run', "Run"), kind: ConfirmationOptionKind.Approve },
+		...(always ? [{ id: alwaysRunOptionId(always.file, always.rule), label: localize('omnide.runPolicy.alwaysRun', "Always Run"), kind: ConfirmationOptionKind.Approve, group: 1 }] : []),
+		{ id: 'skip', label: localize('omnide.runPolicy.skip', "Skip"), kind: ConfirmationOptionKind.Deny, group: 2 },
+	];
+}
