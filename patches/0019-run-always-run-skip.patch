+	/** Always Run: adds the narrow rule to the workspace `.claude/settings.local.json`, never to the user's own settings. */
+	private _writeAlwaysRunRule(file: string, rule: string): void {
+		readFile(file, 'utf8').catch(() => undefined)
+			.then(async text => {
+				await mkdir(path.dirname(file), { recursive: true });
+				await writeFile(file, withAllowRule(text, rule));
+			})
+			.catch(err => this._logService.warn(`[SessionPermissions] Could not write Always Run rule to ${file}: ${err}`));
+	}
