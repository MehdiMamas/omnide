+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+// Wording and classification of calls Claude Code refused without asking. No imports, so tests and both sides of the agent host protocol can share it.
+
+export const BLOCKED_META_KEY = 'omnide.blocked';
+
+export type BlockedKind = 'blocked' | 'classifierError' | 'paused' | 'autoUnavailable';
+
+export interface IBlockedMeta {
+	readonly kind: BlockedKind;
+	readonly tool?: string;
+	readonly reason?: string;
+}
+
+/** Claude Code pauses auto mode after 3 blocks in a row or 20 in total (code.claude.com/docs/en/permission-modes). */
+export const AUTO_PAUSE_CONSECUTIVE = 3;
+export const AUTO_PAUSE_TOTAL = 20;
+
+export interface IDenial {
+	readonly tool: string;
+	readonly reasonType?: string;
+	readonly text: string;
+}
+
+/**
+ * Classifies one denial. The SDK has no structured event for classifier failures, so they are told apart by the documented message
+ * ("cannot determine the safety", "no safety verdict"); paused is counted here with the documented thresholds.
+ */
+export function classifyDenial(d: IDenial, consecutive: number, total: number): { readonly kind: BlockedKind; readonly text: string } {
+	const fromClassifier = d.reasonType === 'classifier';
+	if (fromClassifier && /cannot determine the safety|no safety verdict/i.test(d.text)) {
+		return { kind: 'classifierError', text: `Auto-review could not check ${d.tool}, so it was blocked. Try again, or switch Run Mode.` };
+	}
+	if (fromClassifier && (consecutive === AUTO_PAUSE_CONSECUTIVE || total === AUTO_PAUSE_TOTAL)) {
+		return { kind: 'paused', text: `Auto-review paused after repeated blocks (last: ${d.tool}). Claude will ask you before each call until you approve one.` };
+	}
+	const by = fromClassifier ? 'Auto-review' : d.reasonType === 'rule' ? 'a rule' : d.reasonType === 'mode' ? 'the chat mode' : undefined;
+	return { kind: 'blocked', text: `Blocked ${d.tool}${by ? ` by ${by}` : ''}: ${d.text}` };
+}
+
+export const AUTO_UNAVAILABLE_TEXT = 'Auto-review is not available here (your organization disabled it, or the plan or model does not support it). Using Run on edits instead.';
+
+export function readBlockedMeta(meta: Record<string, unknown> | undefined): IBlockedMeta | undefined {
+	const v = meta?.[BLOCKED_META_KEY];
+	if (typeof v === 'object' && v !== null && 'kind' in v && typeof v.kind === 'string') {
+		return { kind: v.kind as BlockedKind, tool: 'tool' in v && typeof v.tool === 'string' ? v.tool : undefined, reason: 'reason' in v && typeof v.reason === 'string' ? v.reason : undefined };
+	}
+	return undefined;
+}
