+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize, localize2 } from '../../../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../../../platform/actions/common/actions.js';
+import { ServicesAccessor } from '../../../../../../platform/instantiation/common/instantiation.js';
+import { IQuickInputService } from '../../../../../../platform/quickinput/common/quickInput.js';
+import { INotificationService } from '../../../../../../platform/notification/common/notification.js';
+import { IChatWidgetService } from '../../chat.js';
+import { ChatContextKeys } from '../../../common/actions/chatContextKeys.js';
+
+/** Lists what Claude Code refused without asking in the chat that is open, newest first. */
+registerAction2(class ShowRecentlyBlockedAction extends Action2 {
+	constructor() {
+		super({
+			id: 'workbench.action.chat.showRecentlyBlocked',
+			title: localize2('omnide.recentlyBlocked', "Recently Blocked"),
+			f1: true,
+			precondition: ChatContextKeys.enabled,
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const model = accessor.get(IChatWidgetService).lastFocusedWidget?.viewModel?.model;
+		const items: { label: string; description: string }[] = [];
+		for (const request of model?.getRequests() ?? []) {
+			for (const part of request.response?.response.value ?? []) {
+				if (part.kind === 'systemNotification' && part.blocked) {
+					items.unshift({ label: part.blocked.tool ?? localize('omnide.blocked.notice', "Notice"), description: part.content.value });
+				}
+			}
+		}
+		if (!items.length) {
+			accessor.get(INotificationService).info(localize('omnide.blocked.none', "Nothing was blocked in this chat."));
+			return;
+		}
+		await accessor.get(IQuickInputService).pick(items, { placeHolder: localize('omnide.blocked.title', "Recently blocked in this chat") });
+	}
+});
