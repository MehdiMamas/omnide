+	/** Auto can be refused mid-session (plan, model or admin limits); fall back to acceptEdits so the chat keeps working. */
+	private async _setModeOrFallBack(mode: PermissionMode): Promise<void> {
+		let applied = mode;
+		try {
+			await this._query?.setPermissionMode(mode);
+		} catch (err) {
+			if (mode !== 'auto') {
+				throw err;
+			}
+			this._logService.warn(`[ClaudeSdkPipeline:${this.sessionId}] auto mode rejected, using acceptEdits: ${err}`);
+			applied = 'acceptEdits';
+			this._currentPermissionMode = applied;
+			await this._query?.setPermissionMode(applied);
+		}
+		await this._applyPermissionRules(applied);
+		this._appliedPermissionMode = applied;
+	}
