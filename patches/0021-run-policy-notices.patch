+/** A call the SDK refused without asking (auto-review, a deny rule, Ask mode), shown in the chat so the person can see what was blocked and why. */
+function blockedNotice(message: Extract<SDKMessage, { type: 'system'; subtype: 'permission_denied' }>, chat: URI, turnId: string): AgentSignal {
+	const by = message.decision_reason_type === 'classifier' ? 'Auto-review' : message.decision_reason_type === 'rule' ? 'a rule' : message.decision_reason_type === 'mode' ? 'the chat mode' : undefined;
+	const why = message.decision_reason ?? message.message;
+	return {
+		kind: 'action',
+		resource: chat,
+		action: {
+			type: ActionType.ChatResponsePart,
+			turnId,
+			part: {
+				kind: ResponsePartKind.SystemNotification,
+				content: `Blocked ${message.tool_name}${by ? ` by ${by}` : ''}: ${why}`,
+				_meta: { 'omnide.blocked': { tool: message.tool_name, reason: message.decision_reason_type } },
+			},
+		},
+	};
+}
