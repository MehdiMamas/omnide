Subject: Settings editor: enum values can be greyed out with enumDisabled (issue 19)
Original to OmnIDE.

diff --git a/src/vs/platform/configuration/common/configurationRegistry.ts b/src/vs/platform/configuration/common/configurationRegistry.ts
index 3dd2e4d8..65531405 100644
--- a/src/vs/platform/configuration/common/configurationRegistry.ts
+++ b/src/vs/platform/configuration/common/configurationRegistry.ts
@@ -270,6 +270,11 @@ export interface IConfigurationPropertySchema extends IJSONSchema {
 	 */
 	enumItemLabels?: string[];
 
+	/**
+	 * Enumeration values the Settings editor shows greyed out and cannot be picked.
