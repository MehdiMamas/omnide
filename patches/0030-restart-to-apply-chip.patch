+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Disposable } from '../../../../../../base/common/lifecycle.js';
+import { localize, localize2 } from '../../../../../../nls.js';
+import { IActionViewItemService } from '../../../../../../platform/actions/browser/actionViewItemService.js';
+import { MenuEntryActionViewItem } from '../../../../../../platform/actions/browser/menuEntryActionViewItem.js';
+import { Action2, MenuId, MenuItemAction, registerAction2 } from '../../../../../../platform/actions/common/actions.js';
+import { RunPolicySettingId } from '../../../../../../platform/agentHost/common/claudeRunPolicyConfig.js';
+import { ICommandService } from '../../../../../../platform/commands/common/commands.js';
+import { IConfigurationService } from '../../../../../../platform/configuration/common/configuration.js';
+import { ContextKeyExpr, IContextKeyService, RawContextKey } from '../../../../../../platform/contextkey/common/contextkey.js';
+import { ServicesAccessor } from '../../../../../../platform/instantiation/common/instantiation.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../../../common/contributions.js';
+import { ChatContextKeyExprs } from '../../../common/actions/chatContextKeys.js';
+import { ACTION_ID_NEW_CHAT } from '../../actions/chatActions.js';
+import { IChatWidgetService } from '../../chat.js';
+
+/** Set on every chat that was open when Run Mode changed: it still runs under the old mode. */
+const RunModeStale = new RawContextKey<boolean>('omnideRunModeStale', false);
+
+const RESTART_ACTION_ID = 'omnide.agents.restartToApply';
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: RESTART_ACTION_ID,
+			title: localize2('omnide.runMode.restartToApply', "Restart to apply"),
+			f1: false,
+			menu: [{
+				id: MenuId.ChatInputSecondary,
+				group: 'navigation',
+				order: 1.2,
+				when: ContextKeyExpr.and(ChatContextKeyExprs.isAgentHostSession, RunModeStale),
+			}],
+		});
+	}
+	run(accessor: ServicesAccessor): Promise<void> {
+		return accessor.get(ICommandService).executeCommand(ACTION_ID_NEW_CHAT);
+	}
+});
+
+class RestartChipViewItem extends MenuEntryActionViewItem {
+	protected override updateLabel(): void {
+		super.updateLabel();
+		if (this.label) {
+			this.label.textContent = localize('omnide.runMode.restartChip', "Restart to apply");
+			this.label.style.cssText = 'padding:0 8px;border-radius:10px;border:1px solid #F5B84B;background:rgba(245,184,75,.16);color:#F5B84B;';
+		}
+	}
+}
+
+export class AgentHostRestartChipContribution extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.omnideRestartChip';
+
+	constructor(
+		@IConfigurationService config: IConfigurationService,
+		@IChatWidgetService chatWidgets: IChatWidgetService,
+		@IActionViewItemService viewItems: IActionViewItemService,
+	) {
+		super();
+		this._register(viewItems.register(MenuId.ChatInputSecondary, RESTART_ACTION_ID, (action, options, instantiation) =>
+			action instanceof MenuItemAction ? instantiation.createInstance(RestartChipViewItem, action, options) : undefined));
+		this._register(config.onDidChangeConfiguration(e => {
+			if (e.affectsConfiguration(RunPolicySettingId.RunMode)) {
+				for (const widget of chatWidgets.getAllWidgets()) {
+					RunModeStale.bindTo(widget.scopedContextKeyService as IContextKeyService).set(true);
+				}
+			}
+		}));
+	}
+}
+registerWorkbenchContribution2(AgentHostRestartChipContribution.ID, AgentHostRestartChipContribution, WorkbenchPhase.AfterRestored);
