+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+// No imports from this repo, so `node --test scripts/run-policy.test.ts` can load it directly.
+
+/** The Run Mode a chat actually runs under: Run Everything before its warning was accepted, and any mode an administrator disabled, run as Allowlist. */
+export function effectiveRunMode(runMode: string, runEverythingAccepted: boolean, adminDisabled: readonly string[]): string {
+	const mode = runMode === 'runEverything' && !runEverythingAccepted ? 'allowlist' : runMode;
+	return adminDisabled.includes(mode) ? 'allowlist' : mode;
+}
+
+/** Which open chats still run under an older effective Run Mode than the one now in force. A change that is undone leaves no chat stale. */
+export class RunModeTracker<K extends object> {
+	private readonly _started = new WeakMap<K, string>();
+
+	private _current: string;
+
+	constructor(current: string) {
+		this._current = current;
+	}
+
+	/** A chat starts under the mode in force now. */
+	start(chat: K): void {
+		this._started.set(chat, this._current);
+	}
+
+	/** The effective mode changed. A chat nobody recorded started under the previous mode. */
+	change(next: string, openChats: Iterable<K>): void {
+		for (const chat of openChats) {
+			if (!this._started.has(chat)) {
+				this._started.set(chat, this._current);
+			}
+		}
+		this._current = next;
+	}
+
+	isStale(chat: K): boolean {
+		return (this._started.get(chat) ?? this._current) !== this._current;
+	}
+}
