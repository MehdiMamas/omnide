+	/** Auto-review stopped or failed on this call. Claude Code can't re-run a refused call, so the card offers Always Run (from now on) and Skip (dismiss). */
+	private _renderBlockedCard(notification: IChatSystemNotificationPart, commandService: ICommandService): HTMLElement {
+		const blocked = notification.blocked!;
+		const card = dom.$('.chat-system-notification-blocked-card');
+		const title = blocked.kind === 'paused'
+			? localize('omnide.blocked.paused', "Auto-review paused")
+			: localize('omnide.blocked.classifierError', "Auto-review could not check this action");
+		dom.append(card, dom.$('div', { style: 'font-weight:600' }, title));
+		const call = blocked.input?.command ?? blocked.input?.file_path ?? blocked.input?.notebook_path ?? blocked.input?.url;
+		if (call) {
+			dom.append(card, dom.$('code', { style: 'display:block;margin:4px 0;white-space:pre-wrap' }, `${blocked.tool ?? ''} ${call}`.trim()));
+		}
+		dom.append(card, dom.$('div', undefined, notification.content.value));
+		const buttons = dom.append(card, dom.$('div', { style: 'display:flex;gap:8px;margin-top:6px' }));
+		if (blocked.tool && blocked.input) {
+			const always = this._register(new Button(buttons, defaultButtonStyles));
+			always.label = localize('omnide.blocked.alwaysRun', "Always Run");
+			this._register(always.onDidClick(() => commandService.executeCommand(ALWAYS_RUN_BLOCKED_COMMAND, blocked.tool, blocked.input)));
+		}
+		const skip = this._register(new Button(buttons, { ...defaultButtonStyles, secondary: true }));
+		skip.label = localize('omnide.blocked.skip', "Skip");
+		this._register(skip.onDidClick(() => { card.style.display = 'none'; }));
+		return card;
+	}
