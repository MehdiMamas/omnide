new file mode 100644
index 00000000..8749854f
--- /dev/null
+++ b/src/vs/platform/agentHost/node/claude/claudeAlwaysRun.ts
@@ -0,0 +1,43 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) OmnIDE contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mkdir, readFile, rename, unlink, writeFile } from 'fs/promises';
+import { dirname, resolve } from 'path';
+
+// No imports from this repo, so `node --test scripts/run-policy.test.ts` can load it directly.
+
+const queues = new Map<string, Promise<void>>();
+let tempCounter = 0;
+
+/**
+ * Read-modify-write of one file. Writes to the same file run one at a time, so two quick calls keep both changes.
+ * Only a missing file (ENOENT) reads as empty; any other read error rejects and leaves the file alone. The new text lands by rename from a temp file in the same directory, so a crash never leaves half a file.
+ */
+export function updateJsonFile(file: string, update: (text: string | undefined) => string): Promise<void> {
+	const key = resolve(file);
+	const run = (queues.get(key) ?? Promise.resolve()).then(() => replaceFile(file, update));
+	const tail = run.catch(() => undefined);
+	queues.set(key, tail);
+	void tail.then(() => queues.get(key) === tail && queues.delete(key));
+	return run;
+}
+
+async function replaceFile(file: string, update: (text: string | undefined) => string): Promise<void> {
+	const text = await readFile(file, 'utf8').catch(e => {
+		if (e instanceof Error && 'code' in e && e.code === 'ENOENT') {
+			return undefined;
+		}
+		throw e;
+	});
+	const next = update(text);
+	await mkdir(dirname(file), { recursive: true });
+	const temp = `${file}.${process.pid}.${tempCounter++}.tmp`;
+	try {
+		await writeFile(temp, next);
+		await rename(temp, file);
+	} catch (e) {
+		await unlink(temp).catch(() => undefined);
+		throw e;
+	}
+}
