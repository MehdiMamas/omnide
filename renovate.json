{
  "$schema": "https://docs.renovate.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^upstream\\.json$/"
      ],
      "matchStrings": [
        "\"repo\": \"(?<depName>microsoft/vscode)\",\\s*\"tag\": \"(?<currentValue>[^\"]+)\",\\s*\"commit\": \"(?<currentDigest>[a-f0-9]{40})\"",
        "\"repo\": \"(?<depName>VSCodium/vscodium)\",\\s*\"tag\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "microsoft/vscode"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "labels": [
        "upstream"
      ],
      "automerge": false
    },
    {
      "matchDepNames": [
        "VSCodium/vscodium"
      ],
      "labels": [
        "upstream",
        "patches-watch"
      ],
      "automerge": false,
      "schedule": [
        "* * 1 * *"
      ]
    }
  ]
}
