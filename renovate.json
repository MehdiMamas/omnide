{
  "$schema": "https://docs.renovate.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^upstream\\.json$/"],
      "matchStrings": [
        "\"repo\": \"(?<depName>microsoft/vscode)\",\\s*\"tag\": \"(?<currentValue>[^\"]+)\"",
        "\"repo\": \"(?<depName>VSCodium/vscodium)\",\\s*\"tag\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["microsoft/vscode"],
      "labels": ["upstream"],
      "automerge": false
    },
    {
      "matchDepNames": ["VSCodium/vscodium"],
      "labels": ["upstream", "patches-watch"],
      "automerge": false
    }
  ]
}
